{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a registered user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "provider": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "provider", "createdAt"]
    },
    "UserPantry": {
      "title": "User Pantry",
      "description": "User's saved pantry ingredients",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "ingredients": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "ingredients", "updatedAt"]
    },
    "SavedRecipe": {
      "title": "Saved Recipe",
      "description": "User's saved favorite recipe",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "recipeId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 300 },
        "badge": { "type": "string", "maxLength": 100 },
        "totalTimeMinutes": { "type": "number" },
        "servings": { "type": "string", "maxLength": 50 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "recipeData": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "recipeId", "title", "recipeData", "savedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile documents keyed by user UID"
    },
    "/users/{userId}/pantry/{pantryId}": {
      "schema": "UserPantry",
      "description": "Stores user pantry items"
    },
    "/users/{userId}/savedRecipes/{savedRecipeId}": {
      "schema": "SavedRecipe",
      "description": "Stores user saved recipes"
    }
  }
}
